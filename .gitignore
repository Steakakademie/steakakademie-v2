# OpenMontage (AGPLv3, eigenes Upstream-Repo) — wird per
# `npm run video:setup` installiert, nicht in dieses Repo vendored.
# Kanonische Steakakademie-Konfiguration liegt in docs/openmontage/.
tools/openmontage/

# Video-Toolkit (MIT, eigenes Upstream-Repo) — wird per `npm run vt:setup[:win]`
# installiert, nicht vendored. Kanonisches Marken-Profil: docs/video-toolkit/brand/.
# .env mit Modal-Endpunkten lebt NUR dort (gitignored mit dem Ordner).
tools/video-toolkit/

# Video-Artefakte: aus script.json + Komposition jederzeit reproduzierbar
# (`npm run video:kerntemperatur`). Fertige Videos gehören nach R2, nicht ins Repo.
video/*/out/
video/*/audio/

# Lose Patch-Dateien im Repo-Root (blockA…blockE): Zwischenstände einer
# Umbau-Session, kein Quellcode. Die Änderungen gehören als Commit ins Repo,
# nicht als .patch daneben.
/*.patch

# Bildstil-Referenz (Moodboard für docs/bildprogramm.md). Lag bis 17.08.2026
