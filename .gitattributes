# Zeilenenden normalisieren — verhindert, dass Windows-CRLF das Frontmatter-
# Parsing (Contentlayer/YAML) bei lokalen Builds bricht und Seiten als 404 dropt.
# Content + Code immer mit LF auschecken, damit lokaler Build == Vercel (Linux).
*.mdx   text eol=lf
*.md    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Erweitert 22.08.2026: restliche Textformate ebenfalls LF — beendet die
# CRLF-Churn (Dutzende scheinbar geaenderte Dateien nach Windows-Zugriff).
*.csv   text eol=lf
*.sql   text eol=lf
*.svg   text eol=lf

# Erweitert 02.10.2026: patch-package schreibt patches/*.patch unter Windows
# mit CRLF neu. Ohne diese Zeile steht die Datei danach dauerhaft als
# „geaendert" im Arbeitsbaum (17 Zeilen rein, 17 raus — nur Zeilenenden).
*.patch text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.toml  text eol=lf
*.xml   text eol=lf
*.sh    text eol=lf

# Windows-Skripte brauchen CRLF
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binaerformate nie anfassen
*.pdf   binary

# Audio: voice-design-ref.wav ist Marcos abgenommene Stimme und laut
# docs/video-toolkit-setup.md §6 unwiederbringlich (Qwen3-TTS hat keinen Seed).
# Explizit binaer, damit keine Zeilenend-Normalisierung sie je anfasst.
*.wav binary
*.mp3 binary
*.flac binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary
# Ergaenzt 10.09.2026: Die Urkunden-Schriften liegen als TTF im Repo
# (src/lib/urkunde/schriften). Ohne Regel entscheidet Git per Heuristik —
# eine falsch normalisierte Schriftdatei waere unbrauchbar.
*.ttf   binary
*.otf   binary
*.tsv   text eol=lf
.gitignore text eol=lf
.nvmrc text eol=lf
