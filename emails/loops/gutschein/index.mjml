<mjml lang="de">
  <!--
    Steakakademie · Loops-Vorlage Geschenkgutschein (LOOPS_VOUCHER_TEMPLATE_ID)
    Geht an den KÄUFER. Gesendet vom Digistore-Webhook (sendVoucherEmail).
    Variablen: {DATA_VARIABLE:voucher_code}, {DATA_VARIABLE:voucher_url}, {DATA_VARIABLE:course_title}
    Betreff in Loops: Dein Geschenkgutschein: {DATA_VARIABLE:course_title}
    Vorschautext:     Code und Geschenkseite zum Ausdrucken.
    Design: docs/loops-mailvorlagen.md · Stand 09.10.2026
  -->
  <mj-head>
    <mj-title>Dein Geschenkgutschein</mj-title>
    <mj-preview>Code und Geschenkseite zum Ausdrucken.</mj-preview>
    <mj-font name="Playfair Display" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&amp;display=swap" />
    <mj-font name="DM Sans" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="'DM Sans', Arial, Helvetica, sans-serif" />
      <mj-text color="#2A1D14" font-size="16px" line-height="1.6" padding="0 0 16px 0" />
      <mj-button background-color="#C8882A" color="#17100B" font-weight="700" font-size="16px" border-radius="4px" inner-padding="13px 24px" align="left" padding="4px 0 20px 0" />
    </mj-attributes>
    <mj-style>
      a { color: #A86E1C; }
      .h1 div { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif !important; }
    </mj-style>
    <mj-raw><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"></mj-raw>
  </mj-head>
  <mj-body background-color="#EFEAE3" width="600px">

    <mj-section background-color="#17100B" padding="16px 28px">
      <mj-group>
        <mj-column width="15%" vertical-align="middle">
          <mj-image src="img/logo.png" alt="Steakakademie" width="48px" height="48px" align="left" padding="0" href="https://steakakademie.de" />
        </mj-column>
        <mj-column width="85%" vertical-align="middle">
          <mj-text padding="0 0 0 4px" color="#E0A54A" font-family="'Playfair Display', Georgia, serif" font-size="17px" letter-spacing="2px" line-height="1.2">STEAKAKADEMIE<br><span style="font-family:'DM Sans',Arial,sans-serif;font-size:10px;letter-spacing:2px;color:#C4A882;">FEUER · WISSEN · GENUSS</span></mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="30px 28px 10px 28px">
      <mj-column>
        <mj-text font-size="11.5px" font-weight="700" letter-spacing="2px" color="#A86E1C" padding="0 0 8px 0">ZUM VERSCHENKEN</mj-text>
        <mj-text css-class="h1" font-family="'Playfair Display', Georgia, 'Times New Roman', serif" font-size="26px" line-height="1.25" font-weight="700" padding="0 0 14px 0">Dein Geschenkgutschein: {DATA_VARIABLE:course_title}</mj-text>
        <mj-text>Danke für deinen Kauf. Unten steht der Code. Du kannst ihn weiterleiten oder die Geschenkseite ausdrucken und verschenken.</mj-text>
      </mj-column>
    </mj-section>

    <!-- Code-Kasten -->
    <mj-section background-color="#FFFFFF" padding="0 28px">
      <mj-column background-color="#FBF6EE" border="1px solid #E7DED2" padding="16px 12px">
        <mj-text align="center" font-size="13px" color="#6E5B4C" padding="0 0 4px 0">Gutschein-Code</mj-text>
        <mj-text align="center" font-family="'Courier New', Courier, monospace" font-size="28px" font-weight="700" letter-spacing="3px" color="#2A1D14" padding="0 0 6px 0">{DATA_VARIABLE:voucher_code}</mj-text>
        <mj-text align="center" font-size="13px" color="#6E5B4C" padding="0">Gültig bis zum 31. Dezember des dritten Jahres nach dem Kauf.<br>Das genaue Datum steht auf der Geschenkseite.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="22px 28px 10px 28px">
      <mj-column>
        <mj-button href="{DATA_VARIABLE:voucher_url}">Geschenkseite öffnen</mj-button>
        <mj-text font-size="13.5px" color="#6E5B4C">Eingelöst wird der Code auf <a href="https://steakakademie.de/gutschein/einloesen" style="color:#A86E1C;">steakakademie.de/gutschein/einloesen</a>. Die beschenkte Person legt dabei ein kostenloses Konto an, danach ist das Produkt freigeschaltet.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F5F1EB" padding="18px 28px 20px 28px">
      <mj-column>
        <mj-text font-size="12.5px" color="#6E5B4C" line-height="1.6" padding="0">Steakakademie · Uwe Yendell · Wuppertal<br>Fragen? <a href="mailto:pitmaster@steakakademie.de" style="color:#6E5B4C;">pitmaster@steakakademie.de</a> · <a href="https://steakakademie.de/impressum" style="color:#6E5B4C;">Impressum</a> · <a href="https://steakakademie.de/agb" style="color:#6E5B4C;">AGB § 5a</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
