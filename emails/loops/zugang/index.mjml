<mjml lang="de">
  <!--
    Steakakademie · Loops-Vorlage „LogIn Link" (LOOPS_MAGIC_LINK_TEMPLATE_ID)
    Zugang nach dem Kauf. Gesendet vom Digistore-Webhook (sendMagicLink).
    Variablen: {DATA_VARIABLE:magic_link}, {DATA_VARIABLE:course_title}
    Betreff in Loops: Dein Zugang zur Steakakademie ist da
    Vorschautext:     Ein Klick, und du bist drin.
    Design: docs/loops-mailvorlagen.md · Stand 09.10.2026
  -->
  <mj-head>
    <mj-title>Dein Zugang zur Steakakademie</mj-title>
    <mj-preview>Ein Klick, und du bist drin.</mj-preview>
    <mj-font name="Playfair Display" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&amp;display=swap" />
    <mj-font name="DM Sans" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="'DM Sans', Arial, Helvetica, sans-serif" />
      <mj-text color="#2A1D14" font-size="16px" line-height="1.6" padding="0 0 16px 0" />
      <mj-button background-color="#C8882A" color="#17100B" font-weight="700" font-size="16px" border-radius="4px" inner-padding="13px 24px" align="left" padding="4px 0 20px 0" />
    </mj-attributes>
    <mj-style>
      a { color: #A86E1C; }
      .h1 div { font-family: 'Playfair Display', Georgia, 'Times New Roman', serif !important; }
    </mj-style>
    <mj-raw><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"></mj-raw>
  </mj-head>
  <mj-body background-color="#EFEAE3" width="600px">

    <!-- Kopfband -->
    <mj-section background-color="#17100B" padding="16px 28px">
      <mj-group>
        <mj-column width="15%" vertical-align="middle">
          <mj-image src="img/logo.png" alt="Steakakademie" width="48px" height="48px" align="left" padding="0" href="https://steakakademie.de" />
        </mj-column>
        <mj-column width="85%" vertical-align="middle">
          <mj-text padding="0 0 0 4px" color="#E0A54A" font-family="'Playfair Display', Georgia, serif" font-size="17px" letter-spacing="2px" line-height="1.2">STEAKAKADEMIE<br><span style="font-family:'DM Sans',Arial,sans-serif;font-size:10px;letter-spacing:2px;color:#C4A882;">FEUER · WISSEN · GENUSS</span></mj-text>
        </mj-column>
      </mj-group>
    </mj-section>

    <!-- Inhalt -->
    <mj-section background-color="#FFFFFF" padding="30px 28px 10px 28px">
      <mj-column>
        <mj-text font-size="11.5px" font-weight="700" letter-spacing="2px" color="#A86E1C" padding="0 0 8px 0">DEIN KAUF</mj-text>
        <mj-text css-class="h1" font-family="'Playfair Display', Georgia, 'Times New Roman', serif" font-size="26px" line-height="1.25" font-weight="700" padding="0 0 14px 0">Dein Zugang ist da</mj-text>
        <mj-text>Danke für deinen Kauf. Freigeschaltet: <strong>{DATA_VARIABLE:course_title}</strong>. Mit dem Button meldest du dich an und landest direkt bei deinem Produkt. Ein Passwort brauchst du nicht.</mj-text>
        <mj-button href="{DATA_VARIABLE:magic_link}">Jetzt einloggen</mj-button>
        <mj-text font-size="13.5px" color="#6E5B4C">Der Link gilt rund 60 Minuten. Ist er abgelaufen, fordere auf der Login-Seite einfach einen neuen an.</mj-text>
        <mj-divider border-color="#E7DED2" border-width="1px" padding="4px 0 16px 0" />
        <mj-text font-size="13px" color="#6E5B4C">Button geht nicht? Diese Adresse in den Browser kopieren:<br><a href="{DATA_VARIABLE:magic_link}" style="color:#A86E1C;word-break:break-all;">{DATA_VARIABLE:magic_link}</a></mj-text>
      </mj-column>
    </mj-section>

    <!-- Fußzeile -->
    <mj-section background-color="#F5F1EB" padding="18px 28px 20px 28px">
      <mj-column>
        <mj-text font-size="12.5px" color="#6E5B4C" line-height="1.6" padding="0">Steakakademie · Uwe Yendell · Wuppertal<br>Fragen? <a href="mailto:pitmaster@steakakademie.de" style="color:#6E5B4C;">pitmaster@steakakademie.de</a> · <a href="https://steakakademie.de/impressum" style="color:#6E5B4C;">Impressum</a> · <a href="https://steakakademie.de/datenschutz" style="color:#6E5B4C;">Datenschutz</a></mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
