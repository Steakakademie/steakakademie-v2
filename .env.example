# ─── Analytics ───────────────────────────────────────────────────────────────
# Plausible (cookieless, EU) — Konfiguration steckt im PlausibleScript-Tag,
# kein API-Key nötig. data-domain = steakakademie.de
#
# Microsoft Clarity (Heatmaps/Session-Analyse, EINWILLIGUNGSPFLICHTIG).
# Laedt nur nach Opt-in im Consent-Banner. Project-ID "wv3l573awi" ist als Default
# im Code hinterlegt (oeffentlich, analog Plausible-Domain) — hier nur setzen, wenn
# eine ANDERE ID genutzt werden soll.
NEXT_PUBLIC_CLARITY_ID=

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
# Service-Role (NUR server-seitig, NIE ins Frontend, NIE in Git):
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# ─── Loops.so (Transactional E-Mail) ───────────────────────────────────────────
LOOPS_API_KEY=xxxxxxxxxxxx
# Template-ID des Magic-Link-Templates (Loops → Transactional):
LOOPS_MAGIC_LINK_TEMPLATE_ID=xxxxxxxxxxxx
# Template-ID der DOI-Bestätigungsmail (Loops → Transactional, PUBLISHED!).
# Fehlte diese Variable, lief der Newsletter-Trichter wochenlang stumm ins Leere
# (Befund 15.08.2026) — deshalb bricht /api/newsletter ohne sie jetzt hart ab.
LOOPS_DOI_TEMPLATE_ID=xxxxxxxxxxxx
# Template-ID der Kontaktformular-Mail (Loops → Transactional).
# Fehlte in Vercel bis 21.08.2026 — /api/kontakt hat gespeichert, aber nie versendet.
LOOPS_KONTAKT_TEMPLATE_ID=xxxxxxxxxxxx
# Template-ID der Gutschein-Mail (Digistore24-Webhook bei Geschenk-Käufen).
# Fehlt sie, wirft der Webhook 500 und Digistore24 wiederholt die Zustellung: Der
# Gutschein liegt dann in der DB, der Käufer bekommt nichts.
LOOPS_VOUCHER_TEMPLATE_ID=xxxxxxxxxxxx
# Template-ID der Widerrufsbestätigung (in Vercel gesetzt, hier bis 21.08.2026 undokumentiert):
LOOPS_WIDERRUF_TEMPLATE_ID=xxxxxxxxxxxx
# HMAC-Secret für die Ziehungs-Tokens der Stufenprüfung (08.09.2026, Rahmenlehrplan §8).
# Der Server zieht die Fragen und signiert die Ziehung; ohne Secret fällt der Code
# auf NEWSLETTER_DOI_SECRET zurück, in der Produktion ohne beides: Prüfung aus (503).
# Eigenen Wert setzen: `openssl rand -hex 32`. Wechsel macht laufende Prüfungen ungültig (30 min).
DIPLOM_PRUEFUNG_SECRET=xxxxxxxxxxxx
# HMAC-Secret für DOI-Bestätigungslinks (min. 32 Zufallszeichen, z.B. `openssl rand -hex 32`).
# Ohne diese Variable signiert der Code mit einem unsicheren Dev-Fallback!
NEWSLETTER_DOI_SECRET=xxxxxxxxxxxx

# ─── App-Basis-URL (Bestätigungslinks in DOI-Mails) ───────────────────────────
# ACHTUNG Verwechslungsgefahr (Befund 16.08.2026): Das ist die WEBSITE-Domain,
# NICHT die Supabase-URL! Supabase gehört in NEXT_PUBLIC_SUPABASE_URL.
# Ungesetzt fällt der Code korrekt auf https://steakakademie.de zurück.
NEXT_PUBLIC_APP_URL=https://steakakademie.de

# ─── Digistore24 Webhook ───────────────────────────────────────────────────────
# Secret-Token, das in der Webhook-URL als ?token=... mitgegeben wird.
# Beliebiger Zufallsstring (z.B. `node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"`).
# Webhook-URL in Digistore24:
#   https://steakakademie.de/api/webhooks/digistore24?token=<DIGISTORE_WEBHOOK_TOKEN>
DIGISTORE_WEBHOOK_TOKEN=xxxxxxxxxxxx

# ─── KI / Wissensdatenbank (RAG) ───────────────────────────────────────────────
# Claude (Generierung/Verstehen) — von den Agenten-Skripten via @ai-sdk/anthropic genutzt.
ANTHROPIC_API_KEY=xxxxxxxxxxxx
# Voyage AI (Embeddings fuer scripts/kochwissen-ingest.mjs; Modell voyage-3.5 -> 1024 Dim.)
VOYAGE_API_KEY=xxxxxxxxxxxx

# --- fal.ai LoRA-Overrides (optional; Defaults stehen im jeweiligen Skript) ---
# Rohfleisch-/Metzger-Stil fuer Cut-Fotos (scripts/cut-images.mjs)
FAL_LORA_RAWCUT=
# Hausstil "Warm & Rustikal" fuer Rezept-/Grillfotos (scripts/recipe-images.mjs, api/rezept-bild)
FAL_LORA_FOODSTYLE=

# Sentry (EU-Region). Der DSN ist oeffentlich - kein Geheimnis.
NEXT_PUBLIC_SENTRY_DSN="https://68e5cfb47cf41a84b6f4f44c8db4b2b3@o4511949595934720.ingest.de.sentry.io/4511949677985872"
# Nur fuer den Build (Source-Map-Upload). In Vercel als Secret, NIE committen.
SENTRY_AUTH_TOKEN=""

# ── Voyage AI (Stand 22.08.2026) ─────────────────────────────────────────────
# Reranker fuer die Wissenssuche: rerank-2.5-lite (schnell) | rerank-2.5 (beste
# Qualitaet). Beide mit 200M Free-Tier-Tokens. "VOYAGE_RERANK=off" schaltet die
# Rerank-Stufe ab (Suche faellt auf reine Vektor-Reihenfolge zurueck).
VOYAGE_RERANK_MODEL="rerank-2.5-lite"
# VOYAGE_RERANK="off"
# Nacht-Index (knowledge_embeddings): voyage-4 (200M Tokens frei). Ein Wechsel
# hier bettet beim naechsten Lauf automatisch alles neu ein.
# VOYAGE_INDEX_MODEL="voyage-4"
# Kochwissen-Queries: MUSS zum Korpus passen. Seit 22.08.2026 (Re-Embed via
# scripts/kochwissen-reembed.mjs) ist der Korpus voyage-4.
VOYAGE_MODEL="voyage-4"

# ── Gutschein-Checkouts (Digistore24 "Geschenkgutschein"-Produktvarianten) ────
# Fehlt eine Variable, zeigt /gutschein für das Produkt "In Vorbereitung".
# Anlage-Schritte: docs/weihnachts-gutschein-checkliste.md
# NEXT_PUBLIC_DS_VOUCHER_MEIN_PROTOKOLL="https://www.checkout-ds24.com/product/<id>"
# NEXT_PUBLIC_DS_VOUCHER_STEAK_BEICHTE="https://www.checkout-ds24.com/product/<id>"
# NEXT_PUBLIC_DS_VOUCHER_BBQ_GRUNDKURS=""   # erst nach Video-Kurs-Fertigstellung!

# --- A/B-Test Startseite ("Editorial Ember") ---
# 1 = Test aktiv (50/50-Split per Cookie sa_ab_home, Variante B = /home-b).
# Alles andere / nicht gesetzt = AUS, alle Besucher sehen Variante A.
# Steht seit dem 26.08.2026 bewusst auf AUS: Variante B ist optisch defekt
# (Kontraste unter 1,2:1 in Navigation, Topbar und Hero). Erst nach Abnahme
# des hellen Looks wieder auf 1 setzen — in Vercel unter Production.
AB_HOME_ENABLED=0

# Stufe 2: Erfahrungsberichte unter Streitfaellen ("1" = sichtbar)
STREITFALL_BEITRAEGE_ENABLED="1"

# ── Gedruckte Urkunden (Gelato) ──────────────────────────────────────────────
# Druck und Versand der bestellten Urkunden. Schluessel im Gelato-Dashboard
# unter Developer → API Keys anlegen; er wird nur einmal angezeigt.
# Fehlt er, laesst sich unter /admin/urkunden nichts freigeben — Bestellungen
# werden aber weiter angenommen und gespeichert.
# Produkt und Versandart stehen fest verdrahtet in src/lib/urkunde/gelato.ts:
#   cards_pf_a4_pt_250-gsm-coated-silk_cl_4-0_hor · ups_standard_tariff
# GELATO_API_KEY=""

# ── Hofladen-Radar (/hoefe) ─────────────────────────────────────────────────
# MapTiler-Key (Free-Tier: https://cloud.maptiler.com, Key auf Domain steakakademie.de
# beschraenken). Dient Kartenkacheln (Browser, erst nach Klick-zum-Laden) und
# Ort-Geocoding (Server). Ohne Key: keine Karte, Suche laeuft ueber Nominatim-Fallback.
NEXT_PUBLIC_MAPTILER_KEY=
